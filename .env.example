# Voice agent (outbound calls + TTS)
ELEVENLABS_API_KEY=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Tier 1 triage LLM
GEMINI_API_KEY=
# Optional. Overrides the default model id so a retired model is a config
# fix, not a code change. See triage_engine.py.
GEMINI_MODEL=

# Backboard
BACKBOARD_API_KEY=

# Shared secret required on the voice agent webhook and the /trace stream.
# Leave blank for local development (both are open with no secret set).
# Required before deploying anywhere the backend URL is public.
CARELOOP_WEBHOOK_SECRET=
